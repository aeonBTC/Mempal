<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The platform allows cleartext so custom LAN servers and Tor onion
         services work. Public cleartext is blocked by NetworkPolicy in code. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
